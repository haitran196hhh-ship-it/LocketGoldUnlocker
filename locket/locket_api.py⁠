from flask import Blueprint, jsonify, request

api_bp = Blueprint('api', __name__)

@api_bp.route('/unlock', methods=['POST'])
def unlock_gold():
    data = request.get_json() or {}
    username = data.get('username')
    
    if not username:
        return jsonify({"success": False, "message": "Vui lòng nhập tên tài khoản!"}), 400
    
    try:
        # Chỗ này anh có thể thêm logic xử lý mở khóa ở đây
        return jsonify({
            "success": True, 
            "message": f"Đã gửi yêu cầu xử lý thành công cho tài khoản: {username}"
        })
    except Exception as e:
        return jsonify({"success": False, "message": f"Lỗi hệ thống: {str(e)}"}), 500
